# Copia a server/.env y ajusta. Sin DATABASE_URL se usa PGlite (Postgres embebido) en ./data/pglite.
PORT=3000
# DATABASE_URL=postgres://usuario:clave@localhost:5432/plataforma
BASE_DOMAIN=localhost
PUBLIC_URL=http://localhost:5173

# Secretos (obligatorios con NODE_ENV=production)
APP_KEY=cambia-esto
PAYMENT_WEBHOOK_SECRET=cambia-esto
WHATSAPP_APP_SECRET=cambia-esto
WHATSAPP_VERIFY_TOKEN=cambia-esto
# WHATSAPP_ACCESS_TOKEN=   # sin token, el envío por WhatsApp se simula

# Modelo de lenguaje: con ANTHROPIC_API_KEY se usa Claude; sin ella, el simulador determinista.
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic | mock
# LLM_MODEL=claude-opus-5
