# Copia este archivo a server/.env y completa los valores. Nunca subas server/.env al repositorio.
# En desarrollo todo es opcional: sin credenciales, cada tercero usa su simulador.
# En producción (NODE_ENV=production) el servidor NO arranca si falta algo obligatorio
# y NUNCA activa un simulador por falta de credenciales (salvo SIMULADORES=1).

# --------------------------------------------------------------------- general
NODE_ENV=development
PORT=3000
# Dominio base: cada empresa entra por <subdominio>.<BASE_DOMAIN> (requiere DNS comodín *.tu-dominio)
BASE_DOMAIN=localhost
# URL pública del panel (enlaces en correos, retorno de pagos, logotipo de los correos). En producción, https://
APP_PUBLIC_URL=http://localhost:5173
# URL pública que reciben Meta y Wompi para los webhooks (por defecto, APP_PUBLIC_URL)
# API_PUBLIC_URL=https://app.tu-dominio.com
# Nivel de registro: silent | error | warn | info | debug (los registros nunca incluyen cookies ni tokens)
# LOG_NIVEL=info

# --------------------------------------------------------------------- base de datos
# Producción: PostgreSQL 15+ con codificación UTF8. Sin DATABASE_URL se usa PGlite en PGLITE_DIR.
# DATABASE_URL=postgres://usuario:clave@servidor:5432/omnegia
# DATABASE_POOL_MAX=10
# PGLITE_DIR=./data/pglite

# --------------------------------------------------------------------- seguridad
# Cifra los secretos de terceros guardados en la base. Mínimo 32 caracteres: openssl rand -base64 48
APP_KEY=
# Duración de la sesión y cierre por inactividad
# SESION_DIAS=7
# SESION_INACTIVIDAD_HORAS=12
# Bloqueo por intentos fallidos de inicio de sesión
# LOGIN_MAX_INTENTOS=8
# LOGIN_VENTANA_MIN=15

# --------------------------------------------------------------------- WhatsApp Cloud API (Meta)
# Token de acceso permanente de un usuario del sistema con permiso whatsapp_business_messaging
# WHATSAPP_ACCESS_TOKEN=
# Clave secreta de la app de Meta (Configuración de la app › Básica): verifica la firma de cada webhook
# WHATSAPP_APP_SECRET=
# Texto que inventas tú y escribes igual en Meta al registrar el webhook
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0
# Idioma por defecto de las plantillas aprobadas
# WHATSAPP_IDIOMA_PLANTILLAS=es
# El identificador de cada número (Phone number ID) NO va aquí: cada empresa lo guarda en Configuración › WhatsApp.

# --------------------------------------------------------------------- modelo de lenguaje (Claude)
# ANTHROPIC_API_KEY=
# anthropic | mock (mock solo en desarrollo o SIMULADORES=1)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_TIMEOUT_MS=45000
# LLM_MAX_RETRIES=2
# LLM_MAX_ITERACIONES=6

# --------------------------------------------------------------------- pagos de la plataforma (Wompi)
# Cobro de altas y renovaciones de las empresas. Los cobros de cada comercio a sus clientes
# usan la cuenta propia de cada comercio (se configura en el panel, no aquí).
# wompi | simulada (simulada solo en desarrollo o SIMULADORES=1)
# PAGOS_PROVEEDOR=wompi
# sandbox (llaves pub_test_) | produccion (llaves pub_prod_)
# WOMPI_ENTORNO=sandbox
# WOMPI_LLAVE_PUBLICA=
# WOMPI_SECRETO_INTEGRIDAD=
# WOMPI_SECRETO_EVENTOS=
# Las tarifas de la cotización son de demostración. Ponlo en 1 solo cuando confirmes las comerciales.
# TARIFAS_CONFIRMADAS=0
# Secreto de la pasarela simulada (desarrollo)
# PAYMENT_WEBHOOK_SECRET=dev-pasarela-secreto

# --------------------------------------------------------------------- facturación electrónica
# Solo existe el entorno de pruebas propio (sin validez fiscal). En producción, sin proveedor
# conectado no se emiten facturas.
# FISCAL_PROVIDER=sandbox

# --------------------------------------------------------------------- correo transaccional
# Zoho Mail RECIBE en la bandeja de soporte; Resend (o un SMTP transaccional) ENVÍA.
# No uses el SMTP de Zoho Mail para envíos automáticos: el servidor lo rechaza al arrancar.
# resend | smtp | fake (fake solo en desarrollo). Sin definir: resend si hay RESEND_API_KEY, smtp si hay SMTP_HOST, fake en desarrollo.
# EMAIL_PROVIDER=resend
# re_… (resend.com › API Keys, permiso «Sending access»)
RESEND_API_KEY=
EMAIL_FROM_NAME="Omnegia Soporte"
# dominio verificado en Resend (SPF y DKIM)
EMAIL_FROM_ADDRESS=soporte@brianacevedo.dev
EMAIL_REPLY_TO=soporte@brianacevedo.dev
# recibe los tickets de soporte (Zoho Mail)
EMAIL_SUPPORT_INBOX=soporte@brianacevedo.dev
EMAIL_OTP_EXPIRY_MINUTES=10
# Firma del webhook de Resend (whsec_…): sin ella solo se sabe que Resend aceptó el correo, no si se entregó.
# RESEND_WEBHOOK_SECRET=
# EMAIL_TIMEOUT_MS=15000
# Alternativa: proveedor SMTP transaccional (EMAIL_PROVIDER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# true para el puerto 465 (TLS directo)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Desarrollo: carpeta donde el proveedor falso deja cada correo (por defecto server/.buzon-dev)
# EMAIL_FAKE_DIR=

# --------------------------------------------------------------------- panel del operador
# Precios del modelo en USD por millón de tokens, para estimar el costo técnico de IA.
# IA_PRECIO_ENTRADA_USD_MTOK=
# IA_PRECIO_SALIDA_USD_MTOK=
# APP_VERSION=0.1.0

# --------------------------------------------------------------------- demostración
# habilita simuladores en una instancia de demostración (nunca en la real)
# SIMULADORES=1
# en desarrollo, no carga datos de demostración en una base nueva
# SIN_DEMO=1
