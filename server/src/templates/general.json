  "plantillas_mensaje": [
    {
      "clave": "confirmacion_cita",
      "categoria": "UTILIDAD",
      "cuerpo": "¡Listo, {{cliente}}! Tu cita de {{servicio}} quedó para el {{fecha}} a las {{hora}} con {{recurso}}. Si necesitas cambiarla, escríbenos por aquí."
    },
    {
      "clave": "recordatorio_24h",
      "categoria": "UTILIDAD",
      "cuerpo": "Hola {{cliente}}, te recordamos tu cita de {{servicio}} mañana a las {{hora}} con {{recurso}}. ¿Nos confirmas tu asistencia?"
    },
    {
      "clave": "reprogramacion",
      "categoria": "UTILIDAD",
      "cuerpo": "Hola {{cliente}}, tu cita fue reprogramada para el {{fecha}} a las {{hora}}."
    },
    {
      "clave": "agradecimiento",
      "categoria": "UTILIDAD",
      "cuerpo": "Gracias por visitarnos, {{cliente}}. ¡Te esperamos pronto!"
    },
    {
      "clave": "factura_enviada",
      "categoria": "UTILIDAD",
      "cuerpo": "Hola {{cliente}}, aquí está tu factura electrónica {{numero}} por {{total}}. Consúltala en {{enlace}}"
    }
  ],
  "agentes": [
    {
      "configuracion": "atencion",
      "rol": "agente_atencion",
      "herramientas": [
        "consultar_catalogo",
        "consultar_precio",
        "consultar_disponibilidad",
        "crear_cita",
        "mis_citas",
        "cancelar_cita",
        "consultar_inventario",
        "registrar_venta",
        "generar_enlace_pago",
        "estado_factura",
        "escalar_a_humano"
      ],
      "prompt_base": "Tono cercano y breve, como se habla en un negocio de barrio en Colombia. No negocies precios ni ofrezcas descuentos. Escala a una persona los reclamos, las solicitudes de reembolso y cualquier cosa que no puedas resolver con tus herramientas."
    },
    {
      "configuracion": "asistente",
      "rol": "agente_asistente",
      "herramientas": [
        "resumen_ventas",
        "citas_del_dia",
        "agenda_periodo",
        "stock_bajo_minimo",
        "buscar_cliente",
        "consultar_catalogo",
        "consumo_del_plan",
        "ayuda_plataforma",
        "mostrar_guia",
        "crear_item_catalogo",
        "editar_item_catalogo"
      ],
      "prompt_base": "Eres el asistente del dueño del negocio dentro del panel. Responde con cifras concretas obtenidas de tus herramientas y explica de dónde salen. Si una pregunta no se puede responder con tus herramientas, dilo."
    },
    {
      "configuracion": "copiloto",
      "rol": "agente_copiloto",
      "herramientas": [
        "consultar_catalogo",
        "consultar_disponibilidad",
        "buscar_cliente",
        "historial_cliente"
      ],
      "prompt_base": "Asistes al asesor humano. Resume, busca información y sugiere respuestas. Nunca le hablas al cliente directamente."
    }
  ],
  "politica_riesgo": {
    "crear_cita": "confirmable",
