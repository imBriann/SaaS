{
  "name": "@plataforma/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de la Plataforma SaaS Inteligente Multi-Tenant (PRO-SW-001/002/003)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/seed/run.ts",
    "reset": "tsx src/seed/run.ts --reset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:postgres": "node scripts/pruebas-postgres.mjs",
    "migrar": "tsx src/db/migrar.ts",
    "respaldo": "tsx src/db/respaldo.ts",
    "correo:prueba": "tsx src/email/prueba.ts",
    "operador": "tsx src/seed/operador.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "country-state-city": "^3.2.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "image-size": "^2.0.4",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.15",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
